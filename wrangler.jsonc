{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "aslakhellevik-no",
    "compatibility_date": "2026-04-23",
    "routes": [
        { "pattern": "aslakhellevik.no", "custom_domain": true },
        { "pattern": "www.aslakhellevik.no", "custom_domain": true }
    ],
    "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
    }
}
