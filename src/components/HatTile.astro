---
type Point = [number, number];
type Matrix = [number, number, number, number, number, number];
type ShapeKey = "H" | "T" | "P" | "F";
type Rule =
    | [ShapeKey]
    | [number, number, ShapeKey, number]
    | [number, number, number, number, ShapeKey, number];

interface Child {
    T: Matrix;
    geom: Geom;
}

interface Leaf {
    points: Point[];
    fill: number;
    flipped: boolean;
}

const r3 = Math.sqrt(3);
const hr3 = r3 / 2;
const ident: Matrix = [1, 0, 0, 0, 1, 0];

const hexPt = (x: number, y: number): Point => [x + 0.5 * y, hr3 * y];
const add = (a: Point, b: Point): Point => [a[0] + b[0], a[1] + b[1]];
const sub = (a: Point, b: Point): Point => [a[0] - b[0], a[1] - b[1]];

const inv = (T: Matrix): Matrix => {
    const det = T[0] * T[4] - T[1] * T[3];
    return [
        T[4] / det,
        -T[1] / det,
        (T[1] * T[5] - T[2] * T[4]) / det,
        -T[3] / det,
        T[0] / det,
        (T[2] * T[3] - T[0] * T[5]) / det,
    ];
};

const mul = (A: Matrix, B: Matrix): Matrix => [
    A[0] * B[0] + A[1] * B[3],
    A[0] * B[1] + A[1] * B[4],
    A[0] * B[2] + A[1] * B[5] + A[2],
    A[3] * B[0] + A[4] * B[3],
    A[3] * B[1] + A[4] * B[4],
    A[3] * B[2] + A[4] * B[5] + A[5],
];

const trot = (a: number): Matrix => [
    Math.cos(a),
    -Math.sin(a),
    0,
    Math.sin(a),
    Math.cos(a),
    0,
];

const ttrans = (p: Point): Matrix => [1, 0, p[0], 0, 1, p[1]];
const rotAbout = (p: Point, angle: number): Matrix =>
    mul(ttrans(p), mul(trot(angle), ttrans([-p[0], -p[1]])));

const transPt = (M: Matrix, P: Point): Point => [
    M[0] * P[0] + M[1] * P[1] + M[2],
    M[3] * P[0] + M[4] * P[1] + M[5],
];

const matchSeg = (p: Point, q: Point): Matrix => [
    q[0] - p[0],
    p[1] - q[1],
    p[0],
    q[1] - p[1],
    q[0] - p[0],
    p[1],
];

const matchTwo = (p1: Point, q1: Point, p2: Point, q2: Point): Matrix =>
    mul(matchSeg(p2, q2), inv(matchSeg(p1, q1)));

const intersect = (p1: Point, q1: Point, p2: Point, q2: Point): Point => {
    const d =
        (q2[1] - p2[1]) * (q1[0] - p1[0]) -
        (q2[0] - p2[0]) * (q1[1] - p1[1]);
    const uA =
        ((q2[0] - p2[0]) * (p1[1] - p2[1]) -
            (q2[1] - p2[1]) * (p1[0] - p2[0])) /
        d;
    return [p1[0] + uA * (q1[0] - p1[0]), p1[1] + uA * (q1[1] - p1[1])];
};

class Geom {
    shape: Point[];
    fill: number;
    width: number;
    children: Child[] = [];

    constructor(shape: Point[], fill = 0, width = 1) {
        this.shape = shape;
        this.fill = fill;
        this.width = width;
    }

    addChild(T: Matrix, geom: Geom): void {
        this.children.push({ T, geom });
    }

    evalChild(n: number, i: number): Point {
        return transPt(this.children[n].T, this.children[n].geom.shape[i]);
    }

    recentre(): void {
        const center = this.shape.reduce<Point>(
            (total, point) => add(total, point),
            [0, 0],
        );
        const tr: Point = [-center[0] / this.shape.length, -center[1] / this.shape.length];
        this.shape = this.shape.map((point) => add(point, tr));

        const M = ttrans(tr);
        for (const child of this.children) {
            child.T = mul(M, child.T);
        }
    }
}

// Hat metatile construction adapted from Craig S. Kaplan's BSD-licensed hatviz.
// https://github.com/isohedral/hatviz
const hatOutline: Point[] = [
    hexPt(0, 0),
    hexPt(-1, -1),
    hexPt(0, -2),
    hexPt(2, -2),
    hexPt(2, -1),
    hexPt(4, -2),
    hexPt(5, -1),
    hexPt(4, 0),
    hexPt(3, 0),
    hexPt(2, 2),
    hexPt(0, 3),
    hexPt(0, 2),
    hexPt(-1, 2),
];

function constructPatch(H: Geom, T: Geom, P: Geom, F: Geom): Geom {
    const rules: Rule[] = [
        ["H"],
        [0, 0, "P", 2],
        [1, 0, "H", 2],
        [2, 0, "P", 2],
        [3, 0, "H", 2],
        [4, 4, "P", 2],
        [0, 4, "F", 3],
        [2, 4, "F", 3],
        [4, 1, 3, 2, "F", 0],
        [8, 3, "H", 0],
        [9, 2, "P", 0],
        [10, 2, "H", 0],
        [11, 4, "P", 2],
        [12, 0, "H", 2],
        [13, 0, "F", 3],
        [14, 2, "F", 1],
        [15, 3, "H", 4],
        [8, 2, "F", 1],
        [17, 3, "H", 0],
        [18, 2, "P", 0],
        [19, 2, "H", 2],
        [20, 4, "F", 3],
        [20, 0, "P", 2],
        [22, 0, "H", 2],
        [23, 4, "F", 3],
        [23, 0, "F", 3],
        [16, 0, "P", 2],
        [9, 4, 0, 2, "T", 2],
        [4, 0, "F", 3],
    ];
    const ret = new Geom([], -1, H.width);
    const shapes: Record<ShapeKey, Geom> = { H, T, P, F };

    for (const rule of rules) {
        if (rule.length === 1) {
            ret.addChild(ident, shapes[rule[0]]);
        } else if (rule.length === 4) {
            const [childIndex, edgeIndex, nextShape, nextEdge] = rule;
            const child = ret.children[childIndex];
            const poly = child.geom.shape;
            const p = transPt(child.T, poly[(edgeIndex + 1) % poly.length]);
            const q = transPt(child.T, poly[edgeIndex]);
            const next = shapes[nextShape];
            ret.addChild(
                matchTwo(next.shape[nextEdge], next.shape[(nextEdge + 1) % next.shape.length], p, q),
                next,
            );
        } else {
            const [childPIndex, childPVertex, childQIndex, childQVertex, nextShape, nextEdge] = rule;
            const childP = ret.children[childPIndex];
            const childQ = ret.children[childQIndex];
            const p = transPt(childQ.T, childQ.geom.shape[childQVertex]);
            const q = transPt(childP.T, childP.geom.shape[childPVertex]);
            const next = shapes[nextShape];
            ret.addChild(
                matchTwo(next.shape[nextEdge], next.shape[(nextEdge + 1) % next.shape.length], p, q),
                next,
            );
        }
    }

    return ret;
}

function constructMetatiles(patch: Geom): [Geom, Geom, Geom, Geom] {
    const bps1 = patch.evalChild(8, 2);
    const bps2 = patch.evalChild(21, 2);
    const rbps = transPt(rotAbout(bps1, (-2 * Math.PI) / 3), bps2);
    const p72 = patch.evalChild(7, 2);
    const p252 = patch.evalChild(25, 2);
    const llc = intersect(bps1, rbps, patch.evalChild(6, 2), p72);

    let w = sub(patch.evalChild(6, 2), llc);
    const newHOutline: Point[] = [llc, bps1];
    w = transPt(trot(-Math.PI / 3), w);
    newHOutline.push(add(newHOutline[1], w));
    newHOutline.push(patch.evalChild(14, 2));
    w = transPt(trot(-Math.PI / 3), w);
    newHOutline.push(sub(newHOutline[3], w));
    newHOutline.push(patch.evalChild(6, 2));

    const newH = new Geom(newHOutline, -1, patch.width * 2);
    for (const childIndex of [0, 9, 16, 27, 26, 6, 1, 8, 10, 15]) {
        newH.addChild(patch.children[childIndex].T, patch.children[childIndex].geom);
    }

    const newP = new Geom([p72, add(p72, sub(bps1, llc)), bps1, llc], -1, patch.width * 2);
    for (const childIndex of [7, 2, 3, 4, 28]) {
        newP.addChild(patch.children[childIndex].T, patch.children[childIndex].geom);
    }

    const newF = new Geom(
        [bps2, patch.evalChild(24, 2), patch.evalChild(25, 0), p252, add(p252, sub(llc, bps1))],
        -1,
        patch.width * 2,
    );
    for (const childIndex of [21, 20, 22, 23, 24, 25]) {
        newF.addChild(patch.children[childIndex].T, patch.children[childIndex].geom);
    }

    const aaa = newHOutline[2];
    const bbb = add(newHOutline[1], sub(newHOutline[4], newHOutline[5]));
    const ccc = transPt(rotAbout(bbb, -Math.PI / 3), aaa);
    const newT = new Geom([bbb, ccc, aaa], -1, patch.width * 2);
    newT.addChild(patch.children[11].T, patch.children[11].geom);

    newH.recentre();
    newP.recentre();
    newF.recentre();
    newT.recentre();

    return [newH, newT, newP, newF];
}

function collectLeaves(geom: Geom, transform: Matrix = ident): Leaf[] {
    if (geom.children.length === 0) {
        return [
            {
                points: geom.shape.map((point) => transPt(transform, point)),
                fill: geom.fill,
                flipped: transform[0] * transform[4] - transform[1] * transform[3] < 0,
            },
        ];
    }

    return geom.children.flatMap((child) => collectLeaves(child.geom, mul(transform, child.T)));
}

function createInitialMetatiles(): [Geom, Geom, Geom, Geom] {
    const H1Hat = new Geom(hatOutline, 0);
    const HHat = new Geom(hatOutline, 1);
    const THat = new Geom(hatOutline, 2);
    const PHat = new Geom(hatOutline, 3);
    const FHat = new Geom(hatOutline, 4);

    const HOutline: Point[] = [
        [0, 0],
        [4, 0],
        [4.5, hr3],
        [2.5, 5 * hr3],
        [1.5, 5 * hr3],
        [-0.5, hr3],
    ];
    const HInit = new Geom(HOutline, -1, 2);
    HInit.addChild(matchTwo(hatOutline[5], hatOutline[7], HOutline[5], HOutline[0]), HHat);
    HInit.addChild(matchTwo(hatOutline[9], hatOutline[11], HOutline[1], HOutline[2]), HHat);
    HInit.addChild(matchTwo(hatOutline[5], hatOutline[7], HOutline[3], HOutline[4]), HHat);
    HInit.addChild(
        mul(ttrans([2.5, hr3]), mul([-0.5, -hr3, 0, hr3, -0.5, 0], [0.5, 0, 0, 0, -0.5, 0])),
        H1Hat,
    );

    const TOutline: Point[] = [
        [0, 0],
        [3, 0],
        [1.5, 3 * hr3],
    ];
    const TInit = new Geom(TOutline, -1, 2);
    TInit.addChild([0.5, 0, 0.5, 0, 0.5, hr3], THat);

    const POutline: Point[] = [
        [0, 0],
        [4, 0],
        [3, 2 * hr3],
        [-1, 2 * hr3],
    ];
    const PInit = new Geom(POutline, -1, 2);
    PInit.addChild([0.5, 0, 1.5, 0, 0.5, hr3], PHat);
    PInit.addChild(
        mul(ttrans([0, 2 * hr3]), mul([0.5, hr3, 0, -hr3, 0.5, 0], [0.5, 0, 0, 0, 0.5, 0])),
        PHat,
    );

    const FOutline: Point[] = [
        [0, 0],
        [3, 0],
        [3.5, hr3],
        [3, 2 * hr3],
        [-1, 2 * hr3],
    ];
    const FInit = new Geom(FOutline, -1, 2);
    FInit.addChild([0.5, 0, 1.5, 0, 0.5, hr3], FHat);
    FInit.addChild(
        mul(ttrans([0, 2 * hr3]), mul([0.5, hr3, 0, -hr3, 0.5, 0], [0.5, 0, 0, 0, 0.5, 0])),
        FHat,
    );

    return [HInit, TInit, PInit, FInit];
}

function createHatTiles() {
    const [HInit, TInit, PInit, FInit] = createInitialMetatiles();
    const patch = constructPatch(HInit, TInit, PInit, FInit);
    const [H] = constructMetatiles(patch);
    const leaves = collectLeaves(H).slice(0, 10);
    const points = leaves.flatMap((leaf) => leaf.points);
    const minX = Math.min(...points.map(([x]) => x));
    const maxX = Math.max(...points.map(([x]) => x));
    const minY = Math.min(...points.map(([, y]) => y));
    const maxY = Math.max(...points.map(([, y]) => y));

    const width = 520;
    const height = 190;
    const padding = 16;
    const scale = Math.min((width - padding * 2) / (maxX - minX), (height - padding * 2) / (maxY - minY));
    const offsetX = (width - (maxX - minX) * scale) / 2;
    const offsetY = (height - (maxY - minY) * scale) / 2;

    return {
        width,
        height,
        tiles: leaves.map((leaf) => ({
            flipped: leaf.flipped,
            points: leaf.points
                .map(([x, y]) => `${((x - minX) * scale + offsetX).toFixed(1)},${((y - minY) * scale + offsetY).toFixed(1)}`)
                .join(" "),
        })),
    };
}

const patch = createHatTiles();
---

<figure class="mx-auto mt-10 w-full max-w-md text-center text-accent">
    <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox={`0 0 ${patch.width} ${patch.height}`}
        class="mx-auto h-auto w-full max-w-sm overflow-visible sm:max-w-md"
        role="img"
        aria-labelledby="hat-tiling-title hat-tiling-desc"
    >
        <title id="hat-tiling-title">Small patch of the hat aperiodic monotile</title>
        <desc id="hat-tiling-desc">Ten connected hat tiles arranged as a small aperiodic tiling.</desc>
        <g fill="none" stroke="currentColor" stroke-linejoin="round">
            {
                patch.tiles.map((tile, index) => (
                    <polygon
                        points={tile.points}
                        fill="currentColor"
                        fill-opacity={tile.flipped ? "0.13" : index % 3 === 0 ? "0.085" : "0.045"}
                        stroke-opacity={tile.flipped ? "0.58" : "0.38"}
                        stroke-width={tile.flipped ? "1.3" : "1.05"}
                        vector-effect="non-scaling-stroke"
                    />
                ))
            }
        </g>
    </svg>
    <p class="mx-auto mt-2 max-w-sm text-sm text-muted">
        Lost your <a
            href="https://arxiv.org/abs/2303.10798"
            rel="noopener noreferrer"
            target="_blank">hat</a>?
    </p>
</figure>
