---
import type { IconName } from "./iconTypes";

interface Props {
    name: IconName;
    class?: string;
    label?: string;
    strokeWidth?: number;
}

const {
    name,
    class: className = "w-4 h-4",
    label,
    strokeWidth = 1.8,
} = Astro.props;
---

<svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    role={label ? "img" : undefined}
    aria-label={label}
    aria-hidden={label ? undefined : "true"}
    focusable="false"
>
    {name === "arrow-left" && <path d="M19 12H5m7 7-7-7 7-7" />}
    {
        name === "book-open" && (
            <>
                <path d="M12 7v14" />
                <path d="M3 5.5A2.5 2.5 0 0 1 5.5 3H12v18H5.5A2.5 2.5 0 0 1 3 18.5z" />
                <path d="M21 5.5A2.5 2.5 0 0 0 18.5 3H12v18h6.5a2.5 2.5 0 0 0 2.5-2.5z" />
            </>
        )
    }
    {
        name === "briefcase" && (
            <>
                <path d="M10 6V5a2 2 0 0 1 2-2h0a2 2 0 0 1 2 2v1" />
                <rect x="3" y="6" width="18" height="14" rx="2" />
                <path d="M3 12h18" />
                <path d="M12 12v2" />
            </>
        )
    }
    {
        name === "calendar" && (
            <>
                <rect x="3" y="4" width="18" height="17" rx="2" />
                <path d="M8 2v4M16 2v4M3 10h18" />
            </>
        )
    }
    {
        name === "clock" && (
            <>
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3 2" />
            </>
        )
    }
    {name === "code" && <path d="m8 18-6-6 6-6M16 6l6 6-6 6" />}
    {
        name === "cube" && (
            <>
                <path d="m21 16-9 5-9-5V8l9-5 9 5z" />
                <path d="M3.5 8.5 12 13l8.5-4.5" />
                <path d="M12 22v-9" />
            </>
        )
    }
    {
        name === "external-link" && (
            <>
                <path d="M14 3h7v7" />
                <path d="M10 14 21 3" />
                <path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5" />
            </>
        )
    }
    {
        name === "file-text" && (
            <>
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                <path d="M14 2v6h6" />
                <path d="M8 13h8M8 17h5" />
            </>
        )
    }
    {
        name === "github" && (
            <path
                fill="currentColor"
                stroke="none"
                d="M12 .8a11.2 11.2 0 0 0-3.54 21.83c.56.1.76-.24.76-.54v-2.1c-3.12.68-3.78-1.34-3.78-1.34-.5-1.3-1.25-1.65-1.25-1.65-1.03-.7.08-.68.08-.68 1.13.08 1.72 1.16 1.72 1.16 1.01 1.72 2.65 1.22 3.3.93.1-.73.39-1.22.71-1.5-2.49-.28-5.1-1.24-5.1-5.54 0-1.22.44-2.23 1.16-3.01-.12-.29-.5-1.43.11-2.97 0 0 .95-.3 3.1 1.15a10.7 10.7 0 0 1 5.64 0c2.15-1.46 3.1-1.15 3.1-1.15.61 1.54.23 2.68.11 2.97.72.78 1.16 1.79 1.16 3.01 0 4.31-2.62 5.25-5.12 5.53.4.35.77 1.04.77 2.09v3.1c0 .3.2.65.77.54A11.2 11.2 0 0 0 12 .8Z"
            />
        )
    }
    {
        name === "graduation-cap" && (
            <>
                <path d="m22 10-10-5-10 5 10 5 10-5Z" />
                <path d="M6 12v5c3 2 9 2 12 0v-5" />
                <path d="M22 10v6" />
            </>
        )
    }
    {
        name === "linkedin" && (
            <>
                <rect x="3.5" y="3.5" width="17" height="17" rx="3" />
                <path d="M8 10v7" />
                <path d="M12 17v-4.2a2.6 2.6 0 0 1 5.2 0V17" />
                <path d="M8 7.5v.1" />
            </>
        )
    }
    {
        name === "mail" && (
            <>
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m3 7 9 6 9-6" />
            </>
        )
    }
    {
        name === "rss" && (
            <>
                <path d="M4 11a9 9 0 0 1 9 9" />
                <path d="M4 4a16 16 0 0 1 16 16" />
                <circle cx="5" cy="19" r="1" fill="currentColor" stroke="none" />
            </>
        )
    }
    {
        name === "tag" && (
            <>
                <path d="M20.5 13.5 13.5 20.5a2 2 0 0 1-2.8 0L3 12.8V3h9.8l7.7 7.7a2 2 0 0 1 0 2.8Z" />
                <circle cx="7.5" cy="7.5" r="1" />
            </>
        )
    }
</svg>
