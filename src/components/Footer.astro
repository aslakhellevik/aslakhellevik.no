---
import { SITE, SOCIAL_LINKS } from "../consts";

const year = new Date().getFullYear();
---

<footer class="border-t border-border-subtle mt-20">
    <div
        class="mx-auto max-w-4xl px-6 py-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-sm text-muted"
    >
        <p>© {year} {SITE.name}</p>
        <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
            <li>
                <a href={`mailto:${SOCIAL_LINKS.email}`} class="no-underline hover:text-accent">
                    Email
                </a>
            </li>
            <li>
                <a href={SOCIAL_LINKS.github} class="no-underline hover:text-accent" rel="me">
                    GitHub
                </a>
            </li>
            <li>
                <a href={SOCIAL_LINKS.linkedin} class="no-underline hover:text-accent" rel="me">
                    LinkedIn
                </a>
            </li>
            {
                SOCIAL_LINKS.substack && (
                    <li>
                        <a href={SOCIAL_LINKS.substack} class="no-underline hover:text-accent">
                            Substack
                        </a>
                    </li>
                )
            }
            <li>
                <a href="/rss.xml" class="no-underline hover:text-accent">
                    RSS
                </a>
            </li>
        </ul>
    </div>
</footer>
