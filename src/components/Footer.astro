---
import { SITE, SOCIAL_LINKS } from "../consts";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-border-subtle">
    <div
        class="mx-auto max-w-4xl px-6 py-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-sm text-muted"
    >
        <p>© {year} {SITE.name}</p>
        <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
            <li>
                <a href={`mailto:${SOCIAL_LINKS.email}`} class="inline-flex items-center gap-1.5 no-underline hover:text-accent">
                    <Icon name="mail" class="h-3.5 w-3.5" />
                    Email
                </a>
            </li>
            <li>
                <a href={SOCIAL_LINKS.github} class="inline-flex items-center gap-1.5 no-underline hover:text-accent" rel="me">
                    <Icon name="github" class="h-3.5 w-3.5" />
                    GitHub
                </a>
            </li>
            <li>
                <a href={SOCIAL_LINKS.linkedin} class="inline-flex items-center gap-1.5 no-underline hover:text-accent" rel="me">
                    <Icon name="linkedin" class="h-3.5 w-3.5" />
                    LinkedIn
                </a>
            </li>
            {
                SOCIAL_LINKS.substack && (
                    <li>
                        <a href={SOCIAL_LINKS.substack} class="inline-flex items-center gap-1.5 no-underline hover:text-accent">
                            <Icon name="book-open" class="h-3.5 w-3.5" />
                            Substack
                        </a>
                    </li>
                )
            }
            <li>
                <a href="/rss.xml" class="inline-flex items-center gap-1.5 no-underline hover:text-accent">
                    <Icon name="rss" class="h-3.5 w-3.5" />
                    RSS
                </a>
            </li>
        </ul>
    </div>
</footer>
