---
import Icon from "./Icon.astro";
import type { IconName } from "./iconTypes";

interface Props {
    icon: IconName;
    compact?: boolean;
    class?: string;
}

const { icon, compact = false, class: className = "" } = Astro.props;
---

<span
    class:list={[
        "inline-flex shrink-0 items-center justify-center rounded-md bg-accent/10 text-accent ring-1 ring-accent/10",
        compact ? "h-8 w-8" : "h-10 w-10",
        className,
    ]}
    aria-hidden="true"
>
    <Icon name={icon} class={compact ? "h-4 w-4" : "h-5 w-5"} />
</span>
