---
interface Props {
    soft?: boolean;
}

const { soft = false } = Astro.props;
const lineOpacityScale = soft ? 0.5 : 1;
const groupClass = soft
    ? "opacity-[.45] dark:opacity-[.6]"
    : "opacity-[.7] dark:opacity-100";

const lines = Array.from({ length: 52 }, (_, i) => {
    const baseline = 8 + i * 19;
    const phase = i * 0.42;
    const a1 = 22 + Math.sin(phase) * 16;
    const a2 = 16 + Math.cos(phase * 1.3) * 13;
    const a3 = 18 + Math.sin(phase * 0.7 + 1) * 14;

    const d =
        `M-40 ${(baseline + a1 * 1.2).toFixed(1)} ` +
        `C220 ${(baseline - a1 * 1.1).toFixed(1)}, ` +
        `500 ${(baseline + a2 * 1.4).toFixed(1)}, ` +
        `820 ${(baseline - a2 * 0.9).toFixed(1)} ` +
        `S1180 ${(baseline + a1 * 1.3).toFixed(1)}, ` +
        `1640 ${(baseline + a3 * 0.6).toFixed(1)}`;

    const opacity = (0.085 + (i % 5) * 0.022) * lineOpacityScale;
    const strokeWidth = 0.5 + (i % 4) * 0.07;

    return { d, opacity, strokeWidth };
});
---

<g class={groupClass}>
    {
        lines.map((line) => (
            <path
                d={line.d}
                stroke="currentColor"
                stroke-width={line.strokeWidth}
                stroke-linecap="round"
                opacity={line.opacity}
            />
        ))
    }
</g>
