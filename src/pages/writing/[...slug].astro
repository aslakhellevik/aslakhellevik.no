---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
    const posts = await getCollection("writing", ({ data }) => !data.draft);
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

type Props = { post: CollectionEntry<"writing"> };

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const readingMinutes: number | undefined = remarkPluginFrontmatter.readingTime;

const dateFmt = new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
});
---

<BaseLayout
    title={post.data.title}
    description={post.data.description}
    wide
    backdrop="contour-soft"
    ogType="article"
>
    <article class="py-12 mx-auto max-w-[65ch]">
        <div class="mb-10">
            <a href="/writing" class="inline-flex items-center gap-2 text-sm no-underline text-muted hover:text-accent">
                <Icon name="arrow-left" class="h-4 w-4" />
                All writing
            </a>
        </div>

        <header class="mb-10 pb-8 border-b border-border-subtle">
            <h1
                class="text-4xl sm:text-5xl font-semibold tracking-tight leading-[1.1]"
                style="font-family: var(--font-serif);"
            >
                {post.data.title}
            </h1>
            <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted">
                <span class="inline-flex items-center gap-1.5">
                    <Icon name="calendar" class="h-3.5 w-3.5" />
                    <time datetime={post.data.date.toISOString()}>
                        {dateFmt.format(post.data.date)}
                    </time>
                </span>
                {readingMinutes && (
                    <span class="inline-flex items-center gap-1.5">
                        <Icon name="clock" class="h-3.5 w-3.5" />
                        {readingMinutes} min read
                    </span>
                )}
            </div>
        </header>

        <div class="article">
            <Content />
        </div>
    </article>
</BaseLayout>
