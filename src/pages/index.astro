---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import IconBadge from "../components/IconBadge.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 3);

const dateFmt = new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
});

const highlights = [
    {
        icon: "file-text",
        title: "Blog",
        href: "/blog",
        body: "Understanding and modelling; philosophy, maths, psychology, economics, and random observations about the world.",
    },
    {
        icon: "briefcase",
        title: "Services",
        href: "/services",
        body: "Statistical analysis, research, AI literacy, workflow automation. Wiring reality into math and code.",
    },
    {
        icon: "code",
        title: "Projects",
        href: "/projects",
        body: "Using LLMs and other tools to bring ideas to life.",
    },
] as const;
---

<BaseLayout backdrop="penrose">
    <section class="py-16 sm:py-24">
        <div class="max-w-xl">
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">
            Hei! I'm Aslak.
        </h1>
        <div class="mt-6 space-y-4 text-muted leading-relaxed">
            <p>
                I'm a statistician in practice, philosopher by heart. I love
                digging into the how and why of understanding and modelling.
                This year I am working part-time at SSB modelling Norwegian
                tax and family policy, while exploring what to do next.
                Current ideas:
            </p>
            <ul class="list-disc pl-6 space-y-1 marker:text-muted/60">
                <li>
                    Establish ENK, try my hand at consulting (in progress,
                    see <a href="/services">services</a>)
                </li>
                <li>Write a blog (just started)</li>
                <li>Build with Claude</li>
                <li>
                    Climb the PhD mountain (convince me this is a good idea)
                </li>
                <li>
                    Play squash and <a
                        href="https://boardgamegeek.com/boardgame/200680/agricola-revised-edition"
                        rel="noopener">Agricola</a> while waiting for <a
                        href="https://red.anthropic.com/2026/mythos-preview/"
                        rel="noopener">Mythos</a> to earn me UBI
                </li>
            </ul>
            <p>
                If any of this sounds relevant, please
                <a href="/contact">say hei</a>.
            </p>
        </div>
        </div>

        <ul
            class="mt-10 grid gap-5 border-t border-border-subtle pt-8 sm:grid-cols-3"
        >
            {
                highlights.map((item) => (
                    <li class="flex gap-3 sm:block">
                        <IconBadge icon={item.icon} compact />
                        <div class="sm:mt-4">
                            <h2 class="font-semibold tracking-tight">
                                <a
                                    href={item.href}
                                    class="text-fg no-underline hover:text-accent"
                                >
                                    {item.title}
                                </a>
                            </h2>
                            <p class="mt-1 text-sm leading-relaxed text-muted">
                                {item.body}
                            </p>
                        </div>
                    </li>
                ))
            }
        </ul>
    </section>

    {
        posts.length > 0 && (
            <section class="py-10 border-t border-border-subtle">
                <div class="flex items-baseline justify-between mb-6">
                    <h2 class="text-sm font-medium uppercase tracking-widest text-muted">
                        Recent writing
                    </h2>
                    <a href="/blog" class="text-sm no-underline hover:underline">
                        All posts →
                    </a>
                </div>
                <ul class="space-y-3">
                    {posts.map((post) => (
                        <li class="flex items-baseline justify-between gap-4">
                            <a
                                href={`/blog/${post.id}`}
                                class="inline-flex min-w-0 items-center gap-2 text-fg no-underline hover:text-accent"
                            >
                                <Icon
                                    name="file-text"
                                    class="h-4 w-4 shrink-0 text-accent"
                                />
                                {post.data.title}
                            </a>
                            <span
                                class="inline-flex shrink-0 items-center gap-1.5 text-sm text-muted tabular-nums"
                            >
                                <Icon name="calendar" class="h-3.5 w-3.5" />
                                <time datetime={post.data.date.toISOString()}>
                                    {dateFmt.format(post.data.date)}
                                </time>
                            </span>
                        </li>
                    ))}
                </ul>
            </section>
        )
    }
</BaseLayout>
