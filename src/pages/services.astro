---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import IconBadge from "../components/IconBadge.astro";
import { SOCIAL_LINKS } from "../consts";

const services = [
    {
        icon: "cube",
        title: "Statistics & modelling",
        body: "Figuring out which models are sensible for a problem, with a focus on assumptions. Implementing them and interpreting the results honestly. Experience with causal inference and microsimulation, structural models, psychometrics, and econometrics.",
    },
    {
        icon: "briefcase",
        title: "AI in practice",
        body: "AI literacy, from everyday tasks to advanced tooling: workshops covering prompt strategies and quality control, or automation built for a specific problem in your workflow. Including an honest evaluation of whether automation pays off in your area at all.",
    },
    {
        icon: "book-open",
        title: "Philosophical conversation",
        body: "Structured dialogue around a pre-agreed theme, one-on-one or for a group. Examining assumptions and arguments, with conceptual clarity as the goal.",
    },
] as const;
---

<BaseLayout
    title="Services"
    description="Consulting on statistics and modelling, practical AI use, and philosophical conversation — Oslo or remote."
    backdrop="penrose"
>
    <section class="py-16">
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">
            Services
        </h1>
        <p class="mt-4 text-muted leading-relaxed">
            I take on work in statistics, modelling, and the practical use of
            AI. If you are facing a statistical problem, or something below
            sounds relevant, <a href="/contact/">get in touch</a>.
        </p>

        <ul class="mt-12 divide-y divide-border-subtle border-y border-border-subtle">
            {
                services.map((s) => (
                    <li class="py-7">
                        <div class="flex items-start gap-4 sm:gap-5">
                            <IconBadge icon={s.icon} compact class="mt-0.5" />
                            <div class="min-w-0">
                                <h2 class="text-xl font-semibold tracking-tight">
                                    {s.title}
                                </h2>
                                <p class="mt-2 max-w-3xl text-muted leading-relaxed">
                                    {s.body}
                                </p>
                            </div>
                        </div>
                    </li>
                ))
            }
        </ul>

        <p class="mt-8 text-sm text-muted">
            The first 30 minutes are free, and used to work out feasibility,
            scope, and price. Oslo or remote; English or Norwegian. I usually
            reply within a few days.
        </p>

        <div class="mt-10">
            <a
                href={`mailto:${SOCIAL_LINKS.email}`}
                class="inline-flex items-center gap-2 font-medium"
            >
                <Icon name="mail" class="h-4 w-4" />
                Start a conversation →
            </a>
        </div>
    </section>
</BaseLayout>
