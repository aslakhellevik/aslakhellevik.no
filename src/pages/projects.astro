---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects: {
    title: string;
    description: string;
    href?: string;
    year: string;
}[] = [];
---

<BaseLayout title="Projects">
    <section class="py-16">
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">
            Projects
        </h1>
        <p class="mt-4 text-muted">
            Selected work. More coming soon.
        </p>

        {
            projects.length === 0 ? (
                <p class="mt-12 text-muted italic">
                    Nothing to show here yet — I'm working on it.
                </p>
            ) : (
                <ul class="mt-12 space-y-8">
                    {projects.map((p) => (
                        <li class="border-b border-border-subtle pb-8 last:border-b-0">
                            <div class="flex items-baseline justify-between gap-4">
                                <h2 class="text-xl font-semibold">
                                    {p.href ? (
                                        <a href={p.href} class="no-underline hover:text-accent">
                                            {p.title}
                                        </a>
                                    ) : (
                                        p.title
                                    )}
                                </h2>
                                <span class="text-sm text-muted tabular-nums">
                                    {p.year}
                                </span>
                            </div>
                            <p class="mt-2 text-muted leading-relaxed">
                                {p.description}
                            </p>
                        </li>
                    ))}
                </ul>
            )
        }
    </section>
</BaseLayout>
