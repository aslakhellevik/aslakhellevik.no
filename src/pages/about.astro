---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { getCollection } from "astro:content";
import { WORK, EDUCATION } from "../consts";

const projects = (
    await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const monthYear = new Intl.DateTimeFormat("en-GB", {
    month: "long",
    year: "numeric",
});
---

<BaseLayout
    title="About"
    description="Statistician from Oslo. Microsimulation of tax and labour supply, psychometrics, a master's thesis on network effects, and philosophy."
    wide
>
    <section class="py-16 grid sm:grid-cols-[200px_1fr] gap-8 sm:gap-10 items-start">
        <img
            src="/portrait.jpg"
            alt="Aslak Hellevik"
            width="200"
            height="240"
            class="w-40 sm:w-50 rounded-md bg-surface object-cover aspect-5/6"
        />
        <div>
            <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">
                About
            </h1>
            <div class="mt-6 space-y-4 leading-relaxed">
                <p>
                    I am a statistician from Oslo. This year I am working
                    part-time at Statistics Norway (SSB) and Ebber while
                    establishing myself as a consultant and starting a blog.
                </p>
                <p>
                    At SSB I work in the group for Labour Market and Taxation
                    Research, where I develop a discrete-choice microsimulation
                    model of household labour supply. At Ebber I work on the
                    psychometrics of personality testing, applied to hiring and
                    professional development. Previously I worked on seasonal
                    precipitation forecasting at Norsk Regnesentral, and on
                    regularisation in neural networks at Simula's Bio AI
                    project.
                </p>
                <p>
                    I wrote my <a href="/projects/master-thesis/"
                    >master's thesis</a> on the causal effect of social
                    media use on wellbeing. Using agent-based models, I showed
                    that standard statistical methods can be severely biased
                    when network effects are present. My contribution was a
                    structural model that recovers the true parameters, with a
                    non-linear “cost of missing out” term capturing the
                    relevant network dynamics. I derived maximum likelihood and
                    two-stage least squares estimators for it, and used Monte
                    Carlo simulations to validate the results.
                </p>
                <p>
                    Besides statistics, I have a love for philosophy. In high
                    school I participated in the International Philosophy
                    Olympiad after winning the Norwegian championship. My choice
                    of education and thesis have both been philosophically
                    motivated, and my motivation for writing a blog comes from
                    the same drive to question and model the world.
                </p>
                <p>
                    That drive also has less serious applications. I am very
                    fond of strategic board games, and have played a lot of
                    Agricola over the last few years. You should give it a try!
                    When I was younger I played the Pokémon TCG. In 2013 I won
                    the Norwegian national championship in the junior class and
                    played in the World Championship in Vancouver.
                </p>
                <p>
                    Otherwise I enjoy squash, organising social events, cooking,
                    and reading. Despite the late mention, most of the meaning
                    in my life comes from social relationships, and the degree
                    to which this is true seems to be increasing with time.
                    Because of this I also want to write about how others and I
                    model relationships, and how these models affect us.
                </p>
            </div>
        </div>
    </section>

    <section class="py-12 border-t border-border-subtle">
        <div class="mb-6 flex items-center gap-2 text-muted">
            <Icon name="briefcase" class="h-4 w-4 text-accent" />
            <h2 class="text-sm font-medium uppercase tracking-widest">
                Work
            </h2>
        </div>
        <ul class="divide-y divide-border-subtle">
            {
                WORK.map((w) => (
                    <li class="py-4 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                        <span class="font-medium">
                            {w.url ? (
                                <a href={w.url} class="no-underline hover:text-accent" rel="noopener" target="_blank">
                                    {w.company}
                                </a>
                            ) : (
                                w.company
                            )}
                        </span>
                        <span class="text-sm text-muted">
                            {w.role} · {w.period}
                        </span>
                    </li>
                ))
            }
        </ul>
    </section>

    {
        projects.length > 0 && (
            <section class="py-12 border-t border-border-subtle">
                <div class="mb-6 flex items-center gap-2 text-muted">
                    <Icon name="cube" class="h-4 w-4 text-accent" />
                    <h2 class="text-sm font-medium uppercase tracking-widest">
                        Projects
                    </h2>
                </div>
                <ul class="divide-y divide-border-subtle">
                    {projects.map((p) => (
                        <li class="py-4 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                            <a
                                href={`/projects/${p.id}/`}
                                class="font-medium text-fg no-underline hover:text-accent"
                            >
                                {p.data.title}
                            </a>
                            <span class="text-sm text-muted">
                                {p.data.description} · {monthYear.format(p.data.date)}
                            </span>
                        </li>
                    ))}
                </ul>
            </section>
        )
    }

    <section class="py-12 border-t border-border-subtle">
        <div class="mb-6 flex items-center gap-2 text-muted">
            <Icon name="graduation-cap" class="h-4 w-4 text-accent" />
            <h2 class="text-sm font-medium uppercase tracking-widest">
                Education
            </h2>
        </div>
        <ul class="divide-y divide-border-subtle">
            {
                EDUCATION.map((e) => (
                    <li class="py-4 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                        <span class="font-medium">{e.degree}</span>
                        <span class="text-sm text-muted">
                            {e.institution} · {e.period}
                        </span>
                    </li>
                ))
            }
        </ul>
    </section>
</BaseLayout>
