---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About">
    <section class="py-16">
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">About</h1>
        <div class="mt-8 space-y-5 text-fg leading-relaxed">
            <p>
                A longer bio goes here. Who you are, where you're based, what
                you've worked on, what you care about.
            </p>
            <p>
                A second paragraph can cover your background in more detail —
                education, past roles, the path that led you to AI consulting
                and teaching.
            </p>
            <p>
                A third paragraph for the personal side: interests outside
                work, reading, etc.
            </p>
        </div>
    </section>
</BaseLayout>
