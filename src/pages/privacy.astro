---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SOCIAL_LINKS } from "../consts";
---

<BaseLayout
    title="Privacy"
    description="Privacy policy for aslakhellevik.no."
>
    <section class="py-16">
        <p class="text-sm font-medium uppercase tracking-widest text-muted">
            Privacy
        </p>
        <h1 class="mt-4 text-3xl sm:text-4xl font-semibold tracking-tight">
            Privacy policy
        </h1>
        <p class="mt-2 text-sm text-muted">Last updated: 11 May 2026.</p>

        <div class="mt-10 space-y-8 leading-relaxed">
            <div>
                <h2 class="text-xl font-semibold tracking-tight">Who is responsible</h2>
                <p class="mt-2 text-muted">
                    Aslak Hellevik is responsible for any personal data
                    processed in connection with this website. Questions can be
                    sent to
                    <a href={`mailto:${SOCIAL_LINKS.email}`}>{SOCIAL_LINKS.email}</a>.
                </p>
            </div>

            <div>
                <h2 class="text-xl font-semibold tracking-tight">What this site stores</h2>
                <p class="mt-2 text-muted">
                    This is a static site. It does not use cookies, analytics,
                    or third-party tracking scripts. The only thing stored in
                    your browser is a single <code>theme</code> value in
                    <code>localStorage</code>, used to remember whether you
                    prefer light or dark mode. It never leaves your device. You
                    can clear it at any time through your browser's site data
                    settings.
                </p>
            </div>

            <div>
                <h2 class="text-xl font-semibold tracking-tight">Hosting and logs</h2>
                <p class="mt-2 text-muted">
                    The site is hosted on Cloudflare. Like any web host,
                    Cloudflare may process technical request data (IP address,
                    user agent, requested URL) for security and operational
                    purposes. This processing is covered by
                    <a
                        href="https://www.cloudflare.com/privacypolicy/"
                        rel="noopener noreferrer"
                        target="_blank">Cloudflare's privacy policy</a>.
                </p>
            </div>

            <div>
                <h2 class="text-xl font-semibold tracking-tight">Email contact</h2>
                <p class="mt-2 text-muted">
                    If you send me an email, I store and process the contents
                    of that email solely to reply and follow up on the
                    conversation. I do not use email content for marketing or
                    share it with third parties. You can ask me to delete our
                    correspondence at any time.
                </p>
            </div>

            <div>
                <h2 class="text-xl font-semibold tracking-tight">Your rights</h2>
                <p class="mt-2 text-muted">
                    Under the Norwegian Personal Data Act and the GDPR you have
                    the right to access, correct, or request deletion of any
                    personal data I hold about you. Send a request to the
                    address above and I will respond promptly.
                </p>
            </div>

            <div>
                <h2 class="text-xl font-semibold tracking-tight">Changes</h2>
                <p class="mt-2 text-muted">
                    If this policy changes, the "last updated" date above will
                    change. Material changes will be flagged on the front page
                    for a short period.
                </p>
            </div>
        </div>
    </section>
</BaseLayout>
