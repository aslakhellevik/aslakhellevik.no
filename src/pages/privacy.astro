---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SOCIAL_LINKS } from "../consts";
---

<BaseLayout
    title="Privacy"
    description="Privacy policy for aslakhellevik.no — no cookies, no analytics, no tracking."
>
    <section class="py-16">
        <p class="text-sm font-medium uppercase tracking-widest text-muted">
            Privacy
        </p>
        <h1 class="mt-4 text-3xl sm:text-4xl font-semibold tracking-tight">
            Privacy policy
        </h1>
        <p class="mt-2 text-sm text-muted">Last updated: 21 August 2026.</p>

        <div class="mt-10 space-y-8 leading-relaxed">
            <div>
                <h2 class="text-xl font-semibold tracking-tight">
                    Who is responsible
                </h2>
                <p class="mt-2 text-muted">
                    Aslak Hellevik is responsible for personal data
                    processed in connection with this website. Questions go to
                    <a href={`mailto:${SOCIAL_LINKS.email}`}>{SOCIAL_LINKS.email}</a>.
                </p>
            </div>

            <div>
                <h2 class="text-xl font-semibold tracking-tight">
                    What this site collects
                </h2>
                <p class="mt-2 text-muted">
                    Nothing. There are no cookies, no analytics, and no tracking
                    scripts. The only thing this site itself stores in your
                    browser is a <code>theme</code> value in
                    <code>localStorage</code>, remembering whether you prefer
                    light or dark mode. The site
                    is hosted on <a
                        href="https://www.cloudflare.com/privacypolicy/"
                        rel="noopener noreferrer"
                        target="_blank">Cloudflare</a> and fonts are served by
                    <a
                        href="https://bunny.net/privacy"
                        rel="noopener noreferrer"
                        target="_blank">Bunny Fonts</a>. Both receive technical
                    request data (IP address, user agent, requested URL), as any
                    host does.
                </p>
                <p class="mt-4 text-muted">
                    This policy covers aslakhellevik.no and its subdomains. The
                    Agricola tool at <a href="https://agricola.aslakhellevik.no"
                        >agricola.aslakhellevik.no</a
                    > also stores which dataset you last viewed and caches its card
                    data for offline use — both stay in your browser and are never
                    sent anywhere.
                </p>
                <p class="mt-4 text-muted">
                    SimNorge at <a href="https://simnorge.aslakhellevik.no"
                        >simnorge.aslakhellevik.no</a
                    > keeps the pupil's fictional persona, their progress through the
                    oppdrag, and the choice of bokmål or nynorsk under a single
                    <code>simnorge:v1</code> key in <code>localStorage</code>. Once
                    the page has loaded it makes no network requests at all, so
                    nothing entered into it is ever transmitted — there is no
                    account, no login, and no server holding pupil data. The
                    «Nullstill alt» button inside the app deletes that key, which
                    is what you want on a shared school machine.
                </p>
            </div>

            <div>
                <h2 class="text-xl font-semibold tracking-tight">
                    If you email me
                </h2>
                <p class="mt-2 text-muted">
                    I store and process your message solely to reply and follow
                    up. I do not use it for marketing or share it with anyone.
                    You can ask me to delete our correspondence at any time.
                </p>
            </div>

            <div>
                <h2 class="text-xl font-semibold tracking-tight">Your rights</h2>
                <p class="mt-2 text-muted">
                    Under the GDPR and the Norwegian Personal Data Act you can
                    request access to, correction of, or deletion of any
                    personal data I hold about you. Write to the address above
                    to request this. You also have the right to lodge a
                    complaint with <a
                        href="https://www.datatilsynet.no/"
                        rel="noopener noreferrer"
                        target="_blank">Datatilsynet</a>, the Norwegian Data
                    Protection Authority.
                </p>
            </div>
        </div>
    </section>
</BaseLayout>
