---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import HatTile from "../components/HatTile.astro";
---

<BaseLayout title="Not found" description="The page you're looking for doesn't exist.">
    <section class="py-24 text-center">
        <p class="text-sm font-medium uppercase tracking-widest text-muted">
            404
        </p>
        <h1 class="mt-4 text-3xl sm:text-4xl font-semibold tracking-tight">
            Page not found
        </h1>
        <p class="mt-4 text-muted">
            The page you're looking for has moved, been renamed, or never existed.
        </p>
        <HatTile />
        <p class="mt-12">
            <a href="/" class="inline-flex items-center gap-2">
                <Icon name="arrow-left" class="h-4 w-4" />
                Back to the front page
            </a>
        </p>
    </section>
</BaseLayout>
