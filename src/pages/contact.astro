---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { SOCIAL_LINKS } from "../consts";
---

<BaseLayout
    title="Contact"
    description="Get in touch with Aslak Hellevik — email, GitHub, LinkedIn and Goodreads."
>
    <section class="py-16">
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">
            Contact
        </h1>
        <p class="mt-6 text-muted leading-relaxed">
            If you have thoughts about my writing, a project, or anything else,
            the best way to reach me is email. I'd genuinely like to hear from
            you, and I reply to most things within a few days.
        </p>

        <div class="mt-10 flex items-center gap-2">
            <Icon name="mail" class="h-5 w-5 shrink-0 text-accent" />
            <a
                href={`mailto:${SOCIAL_LINKS.email}`}
                class="text-xl font-medium"
            >
                {SOCIAL_LINKS.email}
            </a>
        </div>

        <ul class="mt-10 space-y-3 text-muted">
            <li class="flex gap-2">
                <Icon name="book-open" class="mt-1 h-4 w-4 shrink-0 text-accent" />
                <a href={SOCIAL_LINKS.goodreads} rel="me">Goodreads</a> — have
                we read the same books?
            </li>
            <li class="flex gap-2">
                <Icon name="github" class="mt-1 h-4 w-4 shrink-0 text-accent" />
                <a href={SOCIAL_LINKS.github} rel="me">GitHub</a> — code and
                side projects.
            </li>
            <li class="flex gap-2">
                <Icon name="linkedin" class="mt-1 h-4 w-4 shrink-0 text-accent" />
                <a href={SOCIAL_LINKS.linkedin} rel="me">LinkedIn</a> — if you
                feel professional.
            </li>
        </ul>
    </section>
</BaseLayout>
