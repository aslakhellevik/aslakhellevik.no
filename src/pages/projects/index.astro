---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = (
    await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => b.data.year.localeCompare(a.data.year));
---

<BaseLayout title="Projects">
    <section class="py-16">
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">
            Projects
        </h1>
        <p class="mt-4 text-muted">Selected work. More coming soon.</p>

        {
            projects.length === 0 ? (
                <p class="mt-12 text-muted italic">
                    Nothing to show here yet — I'm working on it.
                </p>
            ) : (
                <ul class="mt-12 space-y-5">
                    {projects.map((p) => (
                        <li class="bg-surface rounded-lg p-7">
                            <div class="flex items-baseline justify-between gap-4">
                                <h2 class="text-xl font-semibold tracking-tight">
                                    <a
                                        href={`/projects/${p.id}`}
                                        class="text-fg no-underline hover:text-accent"
                                    >
                                        {p.data.title}
                                    </a>
                                </h2>
                                <span class="shrink-0 text-sm text-muted tabular-nums">
                                    {p.data.year}
                                </span>
                            </div>
                            <p class="mt-2 text-muted leading-relaxed">
                                {p.data.description}
                            </p>
                            {(p.data.link || p.data.repo) && (
                                <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                                    {p.data.link && (
                                        <a href={p.data.link}>Visit ↗</a>
                                    )}
                                    {p.data.repo && (
                                        <a href={p.data.repo}>Code ↗</a>
                                    )}
                                </div>
                            )}
                        </li>
                    ))}
                </ul>
            )
        }
    </section>
</BaseLayout>
