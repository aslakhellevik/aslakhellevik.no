---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { getCollection } from "astro:content";

const projects = (
    await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const monthYear = new Intl.DateTimeFormat("en-GB", {
    month: "long",
    year: "numeric",
});
---

<BaseLayout
    title="Projects"
    description="Research and software projects, with notes on how each was made."
    backdrop="penrose"
>
    <section class="py-16">
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">
            Projects
        </h1>
        <p class="mt-4 text-muted leading-relaxed">
            Recent projects. Main workflow: specify every aspect of an idea in
            detail, iron out uncertainties through reflection and conversation
            with Claude, then work out an agent flow. Let the summoning begin,
            and spend a few hours tweaking what comes back.
        </p>

        {
            projects.length === 0 ? (
                <p class="mt-12 text-muted italic">
                    Nothing to show here yet — I'm working on it.
                </p>
            ) : (
                <ul class="mt-12 divide-y divide-border-subtle border-y border-border-subtle">
                    {projects.map((p) => (
                        <li class="py-7">
                            <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
                                <h2 class="text-xl font-semibold tracking-tight">
                                    <a
                                        href={`/projects/${p.id}/`}
                                        class="text-fg no-underline hover:text-accent"
                                    >
                                        {p.data.title}
                                    </a>
                                </h2>
                                <span class="inline-flex shrink-0 items-center gap-1.5 text-sm text-muted tabular-nums">
                                    <Icon name="calendar" class="h-3.5 w-3.5" />
                                    <time datetime={p.data.date.toISOString()}>
                                        {monthYear.format(p.data.date)}
                                    </time>
                                </span>
                            </div>
                            <p class="mt-2 text-muted leading-relaxed">
                                {p.data.description}
                            </p>
                            {(p.data.link || p.data.repo) && (
                                <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                                    {p.data.link && (
                                        <a
                                            href={p.data.link}
                                            class="inline-flex items-center gap-1.5"
                                        >
                                            <Icon
                                                name="external-link"
                                                class="h-3.5 w-3.5"
                                            />
                                            Visit
                                        </a>
                                    )}
                                    {p.data.repo && (
                                        <a
                                            href={p.data.repo}
                                            class="inline-flex items-center gap-1.5"
                                        >
                                            <Icon
                                                name="code"
                                                class="h-3.5 w-3.5"
                                            />
                                            Code
                                        </a>
                                    )}
                                </div>
                            )}
                        </li>
                    ))}
                </ul>
            )
        }
    </section>
</BaseLayout>
