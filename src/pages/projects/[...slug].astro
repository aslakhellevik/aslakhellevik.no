---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
    const projects = await getCollection("projects", ({ data }) => !data.draft);
    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

type Props = { project: CollectionEntry<"projects"> };

const { project } = Astro.props;
const { Content } = await render(project);

const monthYear = new Intl.DateTimeFormat("en-GB", {
    month: "long",
    year: "numeric",
});
---

<BaseLayout title={project.data.title} description={project.data.description} wide backdrop="penrose" ogType="article">
    <article class="py-12 mx-auto max-w-[65ch]">
        <div class="mb-10">
            <a href="/projects/" class="inline-flex items-center gap-2 text-sm no-underline text-muted hover:text-accent">
                <Icon name="arrow-left" class="h-4 w-4" />
                All projects
            </a>
        </div>

        <header class="mb-10 pb-8 border-b border-border-subtle">
            <h1
                class="text-4xl sm:text-5xl font-semibold tracking-tight leading-[1.1]"
                style="font-family: var(--font-serif);"
            >
                {project.data.title}
            </h1>
            <p class="mt-4 text-lg text-muted leading-relaxed">
                {project.data.description}
            </p>
            <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted">
                <span class="inline-flex items-center gap-1.5 tabular-nums">
                    <Icon name="calendar" class="h-3.5 w-3.5" />
                    <time datetime={project.data.date.toISOString()}>
                        {monthYear.format(project.data.date)}
                    </time>
                </span>
                {project.data.link && (
                    <a
                        href={project.data.link}
                        class="inline-flex items-center gap-1.5"
                    >
                        <Icon name="external-link" class="h-3.5 w-3.5" />
                        {project.data.linkLabel}
                    </a>
                )}
                {project.data.repo && (
                    <a
                        href={project.data.repo}
                        class="inline-flex items-center gap-1.5"
                    >
                        <Icon name="code" class="h-3.5 w-3.5" />
                        Code
                    </a>
                )}
            </div>
        </header>

        <div class="article">
            <Content />
        </div>
    </article>
</BaseLayout>
